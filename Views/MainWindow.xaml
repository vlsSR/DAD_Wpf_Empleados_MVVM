<Window x:Class="WpfApp1.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="WPF empleados" Height="500" Width="800">
        
        
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>   
        </Grid.RowDefinitions>

        <!-- PANEL SUPERIOR: Formulario -->
        <Border Grid.Row="0" Background="#F4F4F6" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Añadir Empleado" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Panel Nombre -->
                    <StackPanel Margin="0,0,0,15">
                        <Label Content="Nombre del Empleado:" />
                        <TextBox Text="{Binding NuevoNombre, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                    </StackPanel>

                    <!-- Panel Departamento -->
                    <StackPanel Margin="10,10,15,0">
                        <Label Content="Departamento:" Padding="0,0,0,3" />
                        <ComboBox ItemsSource="{Binding Departamentos}" SelectedItem="{Binding NuevoDepartamento}" Padding="6"/>
                    </StackPanel>

                    <!-- Checkbox JornadaCompleta -->
                    <CheckBox Content="Jornada Completa" IsChecked="{Binding NuevoActivo}" Margin="0,15,10,0" VerticalAlignment="Center"/>
                    <Button Content="Añadir a la lista" Command="{Binding AgregarEmpleadoCommand}" 
                        Padding="13,6" Background="#007ACC" Foreground="White" FontWeight="Bold" Height="30" Margin="0,15,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- PANEL DERECHO: Lista de empleados -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Listado de Empleados" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

            <!-- ListView con GridView -->
            <ListView Grid.Row="1" ItemsSource="{Binding Empleados}" SelectedItem="{Binding EmpleadoSeleccionado}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="40"/>
                        <GridViewColumn Header="Nombre" DisplayMemberBinding="{Binding Nombre}" Width="160"/>
                        <GridViewColumn Header="Departamento" DisplayMemberBinding="{Binding Departamento}" Width="110"/>
                        <GridViewColumn Header="Salario" DisplayMemberBinding="{Binding Salario, StringFormat={}{0:C}}" Width="80"/>
                        <GridViewColumn Header="Jornada Completa" DisplayMemberBinding="{Binding JornadaCompleta}" Width="110"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- TextBlock inferior con información del elemento seleccionado -->
            <TextBlock Grid.Row="2" Margin="0,10,0,0" FontWeight="SemiBold">
                <Run Text="Seleccionado: " />
                <Run Text="{Binding EmpleadoSeleccionado.Nombre, FallbackValue='Ninguno'}" Foreground="#007ACC" FontWeight="Bold"/>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
